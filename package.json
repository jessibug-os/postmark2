{
  "name": "postmark",
  "version": "1.0.0",
  "description": "POSTMARK — a cozy post-human town-builder. Reactivate clockwork townsfolk and grow a frontier hamlet back into a living town.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:save": "node scripts/save-schema.mjs",
    "test:music": "node scripts/music-shape.mjs",
    "test:golden": "node scripts/music-golden.mjs check music/baseline.json",
    "test:audio": "node scripts/audio-runtime.mjs",
    "music": "node scripts/render-music.mjs",
    "test:silhouette": "node scripts/silhouette.mjs",
    "review": "vite --port 5173 --strictPort --open /review",
    "models": "vite --port 5173 --strictPort --open /models",
    "audio": "vite --port 5173 --strictPort --open /audio",
    "island:field": "node scripts/island-field.mjs",
    "island:cells": "node scripts/island-cells.mjs",
    "island:geometry": "node scripts/island-geometry.mjs",
    "island:traversal": "node scripts/island-traversal.mjs",
    "island:play": "node scripts/island-play.mjs",
    "island:curves": "node scripts/island-curves.mjs",
    "island:template": "node scripts/island-template.mjs",
    "island:repair": "node scripts/repair-templates.mjs",
    "island:editor": "node scripts/island-editor.mjs",
    "island": "vite --port 5173 --strictPort --open /island",
    "grass": "vite --port 5173 --strictPort --open /grass",
    "grass:survey": "node scripts/grass-survey.mjs",
    "island:pieces": "node scripts/acre-sheet.mjs",
    "island:agreement": "node scripts/island-piece-agreement.mjs",
    "island:roles": "node scripts/island-roles.mjs",
    "island:cliffs": "node scripts/island-cliff-tiling.mjs",
    "island:bakeoff": "node scripts/authored-vs-baked.mjs",
    "acre:check": "node scripts/acre-editor.mjs",
    "acre": "vite --port 5173 --strictPort --open /acre",
    "island:override": "node scripts/island-override.mjs",
    "scenes": "node scripts/scenes.mjs",
    "worldsnap": "node scripts/worldsnap.mjs",
    "scene:check": "node scripts/scene-editor.mjs",
    "island:landmarks": "node scripts/place-landmarks.mjs",
    "island:facing": "node scripts/face-landmarks.mjs",
    "scene": "vite --port 5173 --strictPort --open /scene",
    "sky": "vite --port 5173 --strictPort --open /sky",
    "sky:evidence": "node scripts/sky-evidence.mjs",
    "sky:bake": "node scripts/sky-bake.mjs"
  },
  "keywords": [
    "game",
    "threejs",
    "cozy",
    "town-builder"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "lil-gui": "^0.21.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "node-web-audio-api": "^2.1.0",
    "playwright-core": "^1.61.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "private": true
}
