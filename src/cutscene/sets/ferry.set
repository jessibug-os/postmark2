# set: ferry
# name: The ferry
# note: The working vessel the opening starts on. Bow is +Z; the cabin is aft.
# anchor: dock offset 0 0.4 0 turn 0

prop hull ferry.glb

mark deck.player -0.9 0 3
mark deck.recruit 1.55 0 3.2 facing deck.player
mark deck.bow 0 1 5.6
mark cabin.door 0 0 -0.97
mark cabin.offstage 0 0 -3.4
mark dock.wake 0 -0.2 0

seat seat.a -1.55 0.49 4.3 facing 0
seat seat.b 1.55 0.49 4.3 facing 0
seat seat.c -1.55 0.49 1.6 facing 180

aperture 0 0 1
requires water seaward 12
requires standable dock.wake
requires on-acre
requires clear 7
